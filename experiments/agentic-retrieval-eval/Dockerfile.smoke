# Task 1.1: minimal image to verify the Claude Agent SDK can authenticate from inside a
# container using a redacted CLAUDE_CONFIG_DIR (only the claudeAiOauth token, no other service's
# OAuth tokens -- see openspec/changes/agentic-retrieval-eval/design.md, Decision 4 refinement).
# Not the final sandbox image (that's task 2.1) -- this one only proves the auth path works.
FROM python:3.12-slim

RUN pip install --no-cache-dir claude-agent-sdk

WORKDIR /app
COPY smoke_test.py .

CMD ["python", "smoke_test.py"]
